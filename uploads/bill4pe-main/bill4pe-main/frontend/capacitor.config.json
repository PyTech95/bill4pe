{
  "appId": "com.bill4pe.app",
  "appName": "BILL4PE",
  "webDir": "build",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": false,
      "backgroundColor": "#0A1128",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0A1128"
    },
    "Keyboard": {
      "resize": "native"
    }
  }
}
